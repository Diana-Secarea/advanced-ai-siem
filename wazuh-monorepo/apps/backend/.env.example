# ============================================================
# SIEM AI Threat Engine — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ============================================================

# Flask
FLASK_SECRET_KEY=replace_with_64_char_hex_from_python_secrets_token_hex_32
# Comma-separated list of allowed CORS origins (your domain, no trailing slash)
ALLOWED_ORIGINS=https://yourdomain.com

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=wazuh_ai
PG_USER=wazuh
PG_PASSWORD=replace_with_strong_password

# Ollama — one shared instance on THIS host serves every account. Endpoints
# only ship logs; no model is ever downloaded to a customer machine.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# How long the weights stay in memory after a query — the "always hot" vs
# "load on demand" knob. -1 = never unload (GPU / plenty of RAM),
# 30m = warm for a working session then free the memory (CPU-only hosts),
# 0 = unload immediately (every query pays a cold load).
OLLAMA_KEEP_ALIVE=24h

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Wazuh alert paths
ALERTS_LOG=/var/ossec/logs/alerts/alerts.log
ALERTS_DIR=/var/ossec/logs/alerts

# Bind address — keep on loopback unless behind the auth gateway / reverse proxy.
# Every mutating endpoint is UNAUTHENTICATED, so 0.0.0.0 exposes them on the LAN.
BIND_HOST=127.0.0.1
BIND_PORT=5000

# ── Billing (Stripe Checkout — public /landing.html pricing page) ───────────
# Create two recurring Prices in the Stripe dashboard (test mode works: sk_test_…)
# and paste their IDs. Checkout stays disabled (503) until the key is set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ANALYST=
STRIPE_PRICE_TEAM=

# ── Reactor (headless reactive service) ─────────────────────────────────────
# When enabled, a background daemon tails the Wazuh alert stream, scores every
# new alert, and reacts to verdicts at/above REACTOR_MIN_LABEL.
REACTOR_ENABLED=0
REACTOR_MIN_LABEL=HIGH          # CRITICAL | HIGH | POSSIBLE
REACTOR_THRESHOLD=0             # extra score gate 0–100 (0 = label gate only)
REACTOR_POLL_SECONDS=5
REACTOR_DEDUP_SECONDS=300       # suppress repeat (rule+srcip+label) within window
REACTOR_FROM_START=0            # 1 = replay whole alerts.json once on start
# Slack-compatible / generic webhook — receives {text, incident} on each incident
REACTOR_WEBHOOK_URL=
# Optional generic active response — OFF by default. Command runs with {srcip}
# replaced as a subprocess ARG (no shell); only fires for a valid IP. e.g.:
#   REACTOR_ACTIVE_RESPONSE_CMD=/usr/local/bin/notify-soc {srcip}
REACTOR_ACTIVE_RESPONSE=0
REACTOR_ACTIVE_RESPONSE_CMD=

# ── Real Wazuh active-response (execd) ──────────────────────────────────────
# Fires Wazuh's own AR: the reactor writes to queue/alerts/execq and execd runs
# the registered command (firewall-drop) — real iptables block on the src IP.
# SAFETY: off by default; DRY-RUN by default even when enabled (logs the exact
# action without blocking). Set REACTOR_WAZUH_AR_DRYRUN=0 to issue live blocks.
# Only public routable IPs are ever acted on; blocks auto-expire on the timeout.
REACTOR_WAZUH_AR=0
REACTOR_WAZUH_AR_DRYRUN=1            # 1 = log intent only; 0 = live iptables block
REACTOR_WAZUH_AR_COMMAND=firewall-drop   # firewall-drop | host-deny | route-null | ip-customblock
REACTOR_WAZUH_AR_TIMEOUT=600        # seconds until auto-unblock (0 = permanent)
# Extra CIDRs to never block (RFC1918 / loopback / link-local already excluded)
REACTOR_AR_NEVER=
WAZUH_HOME=/var/ossec

# ── Registration & email verification ──────────────────────────────────────
# Self-service sign-up hardening lives in security.py (username/email/password
# screening for emoji, prompt-injection, SQL-injection, and Unicode trickery).
# Email verification: when EMAIL_VERIFY_REQUIRED=1, accounts that supply an
# email must click the verification link before they can sign in. The link is
# emailed in production; without SMTP wired up it is written to the audit log.
EMAIL_VERIFY_REQUIRED=0             # 1 = block login until the email is verified
EMAIL_VERIFY_TTL_HOURS=24          # how long a verification link stays valid
# Base URL used to build verification links (defaults to the request host).
PUBLIC_BASE_URL=
