{
  "uid": "wazuh-reactor",
  "title": "Reactor — Autonomous Response",
  "tags": ["wazuh", "reactor", "soar"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Reactor state",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "wazuh_reactor_enabled", "instant": true, "legendFormat": "enabled", "refId": "A" },
        { "expr": "wazuh_reactor_running", "instant": true, "legendFormat": "running", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": {
        "0": { "text": "OFF", "color": "red" }, "1": { "text": "ON", "color": "green" } } } ] }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "Last scan age (s) — staleness alarm",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Seconds since the reactor last polled the alert stream. If this climbs while enabled, the loop is wedged.",
      "targets": [{ "expr": "wazuh_reactor_last_scan_age_seconds", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 120 } ] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "Active firewall blocks",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "wazuh_reactor_active_blocks", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Incidents in memory",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "wazuh_reactor_incidents", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "Reactor activity (cumulative)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "wazuh_reactor_count{kind=\"scanned\"}", "legendFormat": "alerts scanned", "refId": "A" },
        { "expr": "wazuh_reactor_count{kind=\"fired\"}", "legendFormat": "incidents fired", "refId": "B" },
        { "expr": "wazuh_reactor_count{kind=\"suppressed\"}", "legendFormat": "deduped", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "custom": { "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 6, "type": "timeseries", "title": "Reactive actions taken",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Containment + investigation actions the reactor performed.",
      "targets": [
        { "expr": "wazuh_reactor_count{kind=\"triaged\"}", "legendFormat": "host triage", "refId": "A" },
        { "expr": "wazuh_reactor_count{kind=\"blocked\"}", "legendFormat": "IPs blocked", "refId": "B" },
        { "expr": "wazuh_reactor_count{kind=\"scans\"}", "legendFormat": "host scans", "refId": "C" },
        { "expr": "wazuh_reactor_count{kind=\"notified\"}", "legendFormat": "webhooks", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "custom": { "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 7, "type": "timeseries", "title": "Reactor errors",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "wazuh_reactor_count{kind=\"errors\"}", "legendFormat": "errors", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "spanNulls": true },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    }
  ]
}
