# nginx reverse proxy for Selenne — https://selenne.app
#
# Two details that break things if you skip them:
#   1. SSE chat streaming needs buffering OFF on the stream route, otherwise
#      nginx holds tokens and the "streaming" UI arrives all at once.
#   2. Real client IPs must survive Cloudflare + nginx, or the login lockout
#      and the rate limiter collapse into one shared counter. Needs BOTH
#      ./cloudflare-realip.sh (nginx writes the IP) and TRUST_PROXY=1 in
#      backend.env (the backend reads it). Neither half works alone.
#
#   sudo cp nginx.conf.sample /etc/nginx/sites-available/selenne
#   sudo ln -s /etc/nginx/sites-available/selenne /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d selenne.app -d www.selenne.app
#   sudo ./cloudflare-realip.sh
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name selenne.app www.selenne.app;

    ssl_certificate     /etc/letsencrypt/live/selenne.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/selenne.app/privkey.pem;

    # HTTPS only, remembered by the browser. Add "; preload" once you are sure.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Uploads up to 5 MB (matches the backend's MAX_CONTENT_LENGTH)
    client_max_body_size 6m;

    # --- Cloudflare: restore the visitor's IP -------------------------------
    # NOT configured here. The set_real_ip_from ranges live in a generated
    # drop-in, /etc/nginx/conf.d/cloudflare-realip.conf, so they apply to
    # every server block and can be refreshed without editing this file:
    #
    #     sudo ./cloudflare-realip.sh
    #
    # Skipping it does not break anything visibly — it silently makes every
    # visitor look like a Cloudflare edge node, which collapses the rate
    # limiter and the login lockout. preflight.sh checks for it.

    # SSE streaming endpoints — buffering MUST be off for token-by-token
    # delivery. nginx drops inherited proxy_set_header directives as soon as a
    # location declares its own, so the forwarding headers are repeated here.
    # Keep this list in step with the live site: /stream and /api/agent stream
    # too, and dropping them from here would silently re-buffer them.
    location ~ ^/(stream|api/chat/stream|api/test-shield|api/agent) {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # The console — every page except /landing.html and /login.html sits behind
    # the session cookie, and /admin.html additionally behind the admin role.
    # Both checks live in the backend; nginx just forwards.
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Redirect HTTP → HTTPS (also serves the ACME challenge for renewals)
server {
    listen 80;
    listen [::]:80;
    server_name selenne.app www.selenne.app;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://selenne.app$request_uri; }
}
