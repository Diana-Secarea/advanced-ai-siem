# ── Local compatibility symlinks into wazuh-monorepo/ ──
# These exist so old absolute paths and scripts keep resolving on a dev box.
# They are deliberately NOT committed: GitHub does not follow symlinks, so on
# the website they render as dead one-line files instead of browsable folders.
# The canonical tree is wazuh-monorepo/{apps,services,infra}.
/ai_threat_engine_starter
/backend
/frontend
/improved_UI
/threat_intel
/wazuh-ai-infra

# Tool files
tools/repository_bumper_*
# Backend runtime state (the old backend/… duplicates of these are gone —
# the whole /backend symlink is ignored above)
wazuh-monorepo/apps/backend/incidents.jsonl
wazuh-monorepo/apps/backend/users.db
wazuh-monorepo/apps/backend/alert_session.jsonl
wazuh-monorepo/services/ai-engine/venv
wazuh-monorepo/infra/registry/staging/*.pkl

# ── Runtime state — per-machine, must never sync between dev and production ──
# Application logs (reactor.log is the security audit trail: back it up, don't
# version it — nightly backups cover it).
wazuh-monorepo/apps/backend/logs/
# Learned baseline for the raw-log content model: production's copy encodes what
# is normal *on that host*. Overwriting it from another machine silently
# degrades detection.
wazuh-monorepo/services/ai-engine/data/ai_models/log_baseline.json
# Reactor AI-triage reports written at runtime.
wazuh-monorepo/apps/backend/ai_triage.jsonl
