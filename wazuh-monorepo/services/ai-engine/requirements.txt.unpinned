# AI-SIEM Threat Engine — Python dependencies
# The Flask server, anomaly models, RAG pipeline, and CVE agent all run from
# this single virtual environment.

# ── Machine learning (anomaly detection: Isolation Forest + Autoencoder) ──
scikit-learn>=1.3.0
numpy>=1.24.0
joblib>=1.3.0
pandas>=2.0.0

# ── RAG: vector store + embeddings ──
qdrant-client>=1.17.0          # Qdrant vector DB (hybrid dense+sparse search)
sentence-transformers>=2.2.0   # dense embeddings (all-MiniLM-L6-v2)
fastembed>=0.3.0               # BM25 sparse vectors (Qdrant/bm25)

# ── Relational store (audit backbone: ledger, threat-intel records) ──
psycopg2-binary>=2.9.0         # PostgreSQL adapter

# ── Web API server + dashboard ──
flask>=2.0
flask-cors>=3.0
flask-limiter>=3.0
python-dotenv>=1.0             # loads backend/.env

# ── Utilities ──
requests>=2.31.0               # NVD / CISA-KEV fetchers, Ollama HTTP calls

# ── Documentation (optional — only to (re)generate the ETH thesis .docx) ──
