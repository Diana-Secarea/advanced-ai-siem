# Production environment for the Wazuh AI backend (systemd EnvironmentFile).
# Copy to /etc/wazuh-ai/backend.env and fill in the secrets. NEVER commit real
# values — this file in the repo is a template.

# --- Server ---
BIND_HOST=127.0.0.1
BIND_PORT=5000
WAITRESS_THREADS=8
LOG_LEVEL=INFO
# Behind the selenne.app edge (Cloudflare → nginx → waitress). Makes the login
# lockout and rate limits key on the real visitor IP instead of 127.0.0.1.
# Set to 0 whenever nothing trustworthy rewrites X-Forwarded-For.
TRUST_PROXY=1
# LOG_DIR=/var/log/wazuh-ai        # override if you want logs outside the repo

# --- Logs the Wazuh collector reads (see infra/deploy/wazuh/) ---
# These two are written in formats Wazuh decodes (json / apache) so backend
# events become real alerts. Leave them unset and they land in LOG_DIR, which
# nothing in ossec.conf watches — i.e. the console stays blind to downloads.
# The backend user must be able to write them (install -d -o <user> /var/log/wazuh-ai).
AUDIT_LOG=/var/log/wazuh-ai/selenne-audit.json
ACCESS_LOG=/var/log/flask_access.log

# --- Secrets (REQUIRED — generate real values) ---
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE_ME_64_HEX
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
PG_PASSWORD=CHANGE_ME_strong_db_password

# --- Endpoint enrolment (REQUIRED for the collector downloads) ---
# Without WAZUH_REG_PASSWORD every /api/download/agent/* route returns 503 and
# no customer can install a collector. This value is only half of a pair: the
# manager must also be told to demand it, or enrolment stays open to anyone who
# can reach 1515. On the manager:
#   openssl rand -base64 24 | sudo tee /var/ossec/etc/authd.pass
#   sudo chmod 640 /var/ossec/etc/authd.pass
#   sudo chown root:wazuh /var/ossec/etc/authd.pass
#   # then set <use_password>yes</use_password> in ossec.conf's <auth> block
#   sudo systemctl restart wazuh-manager
# Paste the same string here. preflight.sh checks both halves agree.
WAZUH_REG_PASSWORD=CHANGE_ME_authd_password

# Where the collectors send data. Agent traffic is RAW TCP — agent-auth on 1515
# and the agent's <address> on 1514 — which a Cloudflare-proxied name cannot
# carry: the orange-cloud edge answers on 80/443 only, so enrolment hangs and
# then times out. This must be a DNS-only ("grey cloud") record pointing at the
# origin, which also keeps the bare origin IP out of the repo.
SELENNE_MANAGER_HOST=agents.selenne.app

# The branded https name baked into the installer text, the READMEs and the
# Windows Start Menu shortcut. This one IS the proxied name. Kept separate from
# SELENNE_MANAGER_HOST because one value cannot be both proxied and not.
SELENNE_DASHBOARD_HOST=selenne.app
# Agent version the installers fetch (default 4.14.6 when unset).
# WAZUH_AGENT_VERSION=4.14.6

# --- Email verification (REQUIRED for self-service signup) ---
# A new account is created UNVERIFIED and cannot download a collector until the
# emailed link is opened — the installer carries the shared enrolment password,
# so it must not be reachable from an unconfirmed address. With SMTP unset,
# registration still succeeds but nobody can ever finish it without an admin.
SMTP_HOST=smtp.example.com
SMTP_PORT=587                     # STARTTLS
SMTP_USER=no-reply@selenne.app
SMTP_PASS=CHANGE_ME_smtp_password
# Base URL used to build the verification link. Deliberately NOT taken from the
# request Host header: an attacker-supplied Host would make the server mail a
# victim a link pointing at the attacker.
SELENNE_PUBLIC_URL=https://selenne.app

# --- Auth ---
AUTH_ENABLED=1
AUTH_COOKIE_SECURE=1              # requires HTTPS in front (reverse proxy / TLS)
AUTH_SESSION_TTL_HOURS=72

# --- Dependencies ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
QDRANT_HOST=localhost
QDRANT_PORT=6333
PG_HOST=localhost
PG_PORT=5432
PG_DB=wazuh_ai
PG_USER=wazuh
ALLOWED_ORIGINS=https://selenne.app

# --- CVE agent (auto-runs on boot) ---
CVE_AGENT_AUTOSTART=1
CVE_AGENT_INTERVAL_HOURS=24

# --- Reactor (defaults OFF / dry-run — arm deliberately) ---
REACTOR_ENABLED=1
REACTOR_MIN_LABEL=HIGH
# Reactive actions: enable per action, keep dry-run until you trust them
REACTOR_TRIAGE=1
REACTOR_BLOCK_IP=0
REACTOR_BLOCK_IP_DRYRUN=1
REACTOR_SCAN=0
REACTOR_SCAN_DRYRUN=1
# Score the FULL log-collector stream (archives.json — journald, /var/log/*,
# auditd, command output), not just rule-matched alerts. Off by default; raises
# a "NOVEL LOG" incident for never-before-seen log templates >= LOGSTREAM_MIN.
# Requires <logall_json>yes</logall_json>.
REACTOR_LOGSTREAM=0
REACTOR_LOGSTREAM_MIN=90

# --- Support tickets (optional email; without SMTP they are still stored) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_gmail_app_password
# TICKET_EMAIL_TO=diana.secarea1111@gmail.com

# --- Billing (Stripe Checkout on the public /landing.html; 503 until set) ---
# Create two recurring Prices in the Stripe dashboard and paste the IDs.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ANALYST=price_...
# STRIPE_PRICE_TEAM=price_...
