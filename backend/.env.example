# ============================================================
# SIEM AI Threat Engine — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ============================================================

# Flask
FLASK_SECRET_KEY=replace_with_64_char_hex_from_python_secrets_token_hex_32
# Comma-separated list of allowed CORS origins (your domain, no trailing slash)
ALLOWED_ORIGINS=https://yourdomain.com

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=wazuh_ai
PG_USER=wazuh
PG_PASSWORD=replace_with_strong_password

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Wazuh alert paths
ALERTS_LOG=/var/ossec/logs/alerts/alerts.log
ALERTS_DIR=/var/ossec/logs/alerts
