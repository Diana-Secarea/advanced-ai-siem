{
  "uid": "wazuh-ai-engine",
  "title": "AI Engine — RAG & Copilot",
  "tags": ["wazuh", "rag", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "gauge", "title": "RAG Hit Rate @5",
      "gridPos": { "h": 7, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "wazuh_rag_hit_rate", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "decimals": 3, "unit": "percentunit",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.8 } ] } }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "MRR / Recall@5 / nDCG@5",
      "gridPos": { "h": 7, "w": 7, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "wazuh_rag_mrr", "instant": true, "legendFormat": "MRR", "refId": "A" },
        { "expr": "wazuh_rag_recall_at_k", "instant": true, "legendFormat": "Recall@5", "refId": "B" },
        { "expr": "wazuh_rag_ndcg_at_k", "instant": true, "legendFormat": "nDCG@5", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "decimals": 3 }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "Chat requests (since server start)",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "wazuh_chat_requests_total", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "CVE agent — last run",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "wazuh_cve_agent_running", "instant": true, "legendFormat": "Running", "refId": "A" },
        { "expr": "wazuh_cve_agent_last_returncode", "instant": true, "legendFormat": "Last exit code", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "Retrieval quality over time",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "wazuh_rag_hit_rate", "legendFormat": "Hit rate", "refId": "A" },
        { "expr": "wazuh_rag_mrr", "legendFormat": "MRR", "refId": "B" },
        { "expr": "wazuh_rag_recall_at_k", "legendFormat": "Recall@5", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 6, "type": "bargauge", "title": "Hit rate per query category",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "wazuh_rag_category_hit_rate", "instant": true, "legendFormat": "{{category}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "yellow", "value": 0.6 }, { "color": "green", "value": 0.8 } ] } }, "overrides": [] }
    },
    {
      "id": 7, "type": "timeseries", "title": "Backend uptime & session alerts",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "wazuh_alerts_total", "legendFormat": "Session alerts", "refId": "A" },
        { "expr": "wazuh_server_uptime_seconds / 3600", "legendFormat": "Uptime (h)", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "custom": { "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Chat latency (ms) — 5s target",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Per-stage chat pipeline latency over a rolling window. The red line marks the 5000ms completion target.",
      "targets": [
        { "expr": "wazuh_chat_latency_ms{stage=\"retrieval\",stat=\"avg\"}", "legendFormat": "retrieval avg", "refId": "A" },
        { "expr": "wazuh_chat_latency_ms{stage=\"first_token\",stat=\"avg\"}", "legendFormat": "generation avg", "refId": "B" },
        { "expr": "wazuh_chat_latency_ms{stage=\"total\",stat=\"avg\"}", "legendFormat": "total avg", "refId": "C" },
        { "expr": "wazuh_chat_latency_ms{stage=\"total\",stat=\"p95\"}", "legendFormat": "total p95", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "spanNulls": true },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 5000 } ] } },
        "overrides": [ { "matcher": { "id": "byName", "options": "total avg" },
          "properties": [ { "id": "custom.lineWidth", "value": 3 } ] } ] }
    },
    {
      "id": 9, "type": "stat", "title": "Chat total latency (avg / p95)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "wazuh_chat_latency_ms{stage=\"total\",stat=\"avg\"}", "instant": true, "legendFormat": "avg", "refId": "A" },
        { "expr": "wazuh_chat_latency_ms{stage=\"total\",stat=\"p95\"}", "instant": true, "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 3500 }, { "color": "red", "value": 5000 } ] } }, "overrides": [] }
    },
    {
      "id": 10, "type": "stat", "title": "Completions over 5s target",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "wazuh_chat_over_5s_total", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 11, "type": "stat", "title": "Prompt-injection attempts flagged",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "User messages matching prompt-injection heuristics (flagged + delimited, not blocked).",
      "targets": [{ "expr": "wazuh_chat_injection_flags_total", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] } }, "overrides": [] }
    }
  ]
}
